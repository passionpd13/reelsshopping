# ------------------------------------------------------------------
# Shopping Reels Generator — environment variables
# Copy to .env and fill in real values. .env is gitignored.
# ------------------------------------------------------------------

# App
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
DB_URL=sqlite:///./db.sqlite

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supertone TTS
# https://console.supertone.ai/
SUPERTONE_API_KEY=
SUPERTONE_BASE_URL=https://supertoneapi.com
SUPERTONE_DEFAULT_VOICE_ID=

# Whisper (faster-whisper)
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# yt-dlp
YTDLP_COOKIES_FILE=

# Rendering
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
