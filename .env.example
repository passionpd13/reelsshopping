# ------------------------------------------------------------------
# Shopping Reels Generator — environment variables
# Copy to .env and fill in real values. .env is gitignored.
# ------------------------------------------------------------------

# App
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
DB_URL=sqlite:///./db.sqlite

# ------------------------------------------------------------------
# LLM provider — pick ONE: "anthropic" (direct API) or "vertex" (GCP)
# ------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Direct Anthropic API (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vertex AI on Google Cloud (used when LLM_PROVIDER=vertex)
# - VERTEX_PROJECT_ID: your GCP project id
# - VERTEX_REGION: e.g. us-east5, europe-west4, asia-southeast1 (check model availability)
# - VERTEX_MODEL: Vertex model id, e.g. claude-sonnet-4-5@20250929
# - GOOGLE_APPLICATION_CREDENTIALS: absolute path to service account JSON.
#   Leave empty to use gcloud ADC (application default credentials).
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5
VERTEX_MODEL=claude-sonnet-4-5@20250929
GOOGLE_APPLICATION_CREDENTIALS=

# Supertone TTS
# https://console.supertone.ai/
SUPERTONE_API_KEY=
SUPERTONE_BASE_URL=https://supertoneapi.com
SUPERTONE_DEFAULT_VOICE_ID=

# Whisper (faster-whisper)
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# yt-dlp
YTDLP_COOKIES_FILE=

# Rendering
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
