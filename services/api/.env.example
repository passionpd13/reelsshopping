# --- Required for the PoC ---
# Gemini API key — used for image → product keyword extraction
GEMINI_API_KEY=

# --- Optional: SerpAPI fallback for reliable search ---
# https://serpapi.com — used when direct scraping fails or as primary
SERPAPI_KEY=

# --- Optional: cookies for direct scraping (paste raw Cookie header values) ---
# Without these, Taobao/1688/Douyin search will likely hit anti-bot pages.
TAOBAO_COOKIE=
ALIBABA1688_COOKIE=
DOUYIN_COOKIE=

# --- Behavior ---
# Comma-separated platform order. Options: taobao, alibaba1688, douyin, serpapi
SEARCH_PLATFORMS=taobao,alibaba1688,douyin
# Max candidate product pages to fetch per platform
MAX_CANDIDATES_PER_PLATFORM=8
# Max final downloaded videos
MAX_RESULTS=3
# Where downloaded videos go
DOWNLOAD_DIR=./downloads
